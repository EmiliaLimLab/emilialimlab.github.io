---
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import ResearchAreaIcon from "../components/ResearchAreaIcon.astro";
import CellMorphHero from "../components/CellMorphHero.astro";
import labMeeting from "../assets/photos/lab-meeting.jpg";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import { getPublications } from "../lib/content";
import PubList from "../components/PubList.astro";

const pubs = await getPublications();
// Hand-picked selection for the homepage, in display order.
const selectedSlugs = [
  "2026-anthracosis-quantification",
  "2025-woodsmoke-diesel-exhaust",
  "2023-air-pollutants",
  "2026-egfr-climate-change",
  "2026-data-science-air-pollution",
];
const recent = selectedSlugs
  .map((slug) => pubs.find((p) => p.id === slug))
  .filter((p) => p !== undefined);

const press = (await getCollection("press")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestPress = press.length > 0 ? press[0] : undefined;

// Homepage "Research areas" cards, deep-linking into the Research page's
// grouped sections (see the `areas` taxonomy in content.config.ts).
const themes = [
  { n: 1 as const, heading: "Origins", href: "/research#cancer-origins" },
  { n: 2 as const, heading: "Prevention", href: "/research#cancer-prevention" },
  { n: 3 as const, heading: "Aging", href: "/research#aging-cancer-risk" },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white">
    <div class="container-page py-16 sm:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="text-center lg:text-left">
          <p class="text-sm font-semibold tracking-wide text-accent-600 uppercase">
            {site.university}<br />
            {site.centre}<br />
            {site.institution}
          </p>
          <h1
            class="mt-4 text-4xl leading-tight font-semibold text-slate-900 sm:text-5xl"
          >
            {site.name}
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 lg:mx-0">{site.description}</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
            <a
              href="/research"
              class="rounded-md bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-800"
              >Explore our research</a
            >
            <a
              href="/people"
              class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
              >Meet the team</a
            >
          </div>
        </div>
        <CellMorphHero class="mx-auto" />
      </div>
    </div>
  </section>

  <!-- Research themes -->
  <section class="container-page py-16">
    <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
    <h2 class="mb-8 font-serif text-2xl text-slate-900">Research areas</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {
        themes.map((t) => (
          <a
            href={t.href}
            class="group flex flex-col items-center rounded-xl border border-slate-200 p-6 text-center transition-colors hover:border-primary-300 hover:bg-primary-50/40"
          >
            <ResearchAreaIcon n={t.n} />
            <p class="mt-3 font-serif text-lg text-slate-900 group-hover:text-primary-700">
              {t.heading}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Team photo -->
  <section class="border-t border-slate-200 bg-white">
    <div class="container-page py-16">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <a
          href="/people"
          class="group block overflow-hidden rounded-2xl border border-slate-200 shadow-sm"
        >
          <Image
            src={labMeeting}
            alt="Lab members gathered around a table discussing work"
            widths={[600, 1000, 1600]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            class="aspect-[3/2] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
        </a>
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-2xl text-slate-900">The people behind the work</h2>
          <p class="mt-4 max-w-prose text-slate-600">
            We're a small, collaborative group working across genomics, imaging, and
            data science to understand how environmental exposures shape cancer risk.
          </p>
          <a
            href="/people"
            class="group mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
          >
            Meet the team
            <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent featured publications -->
  {
    recent.length > 0 && (
      <section class="border-t border-slate-200 bg-slate-50">
        <div class="container-page py-16">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500" />
              <h2 class="font-serif text-2xl text-slate-900">Selected publications</h2>
            </div>
            <a
              href="/publications"
              class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
            >
              All publications
              <span
                class="transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
          </div>
          <PubList pubs={recent} />
        </div>
      </section>
    )
  }

  <!-- Latest news -->
  {
    latestPress && (
      <section class="border-t border-slate-200 bg-white">
        <div class="container-page py-16">
          <div class="grid items-center gap-10 lg:grid-cols-2">
            <div>
              <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500" />
              <h2 class="font-serif text-2xl text-slate-900">News</h2>
              <p class="mt-4 text-xs font-medium uppercase tracking-wide text-primary-700">
                {latestPress.data.outlet}
                {" · "}
                {latestPress.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <p class="mt-1 font-serif text-lg text-slate-900">
                {latestPress.data.title}
              </p>
              {latestPress.data.excerpt && (
                <p class="prose-content mt-3 max-w-prose text-sm leading-relaxed text-slate-600">
                  {latestPress.data.excerpt}
                </p>
              )}
              <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
                <a
                  href={latestPress.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
                >
                  Read the coverage
                  <span
                    class="transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true">&rarr;</span
                  >
                </a>
                <a
                  href="/news"
                  class="group inline-flex items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
                >
                  All news
                  <span
                    class="transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true">&rarr;</span
                  >
                </a>
              </div>
            </div>
            {latestPress.data.image && (
              <a
                href={latestPress.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block overflow-hidden rounded-2xl border border-slate-200 shadow-sm"
              >
                <Image
                  src={latestPress.data.image}
                  alt={latestPress.data.imageAlt ?? latestPress.data.title}
                  widths={[600, 1000]}
                  sizes="(min-width: 1024px) 45vw, 90vw"
                  class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                />
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
