---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import { getPublications } from "../lib/content";
import anthracosis from "../assets/photos/anthracosis.jpg";

const pubs = await getPublications();
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed publications from the lab."
>
  <PageHeader
    eyebrow="Research output"
    title="Publications"
    lead="Peer-reviewed work from the lab and its collaborators."
    image={anthracosis}
    imageAlt="H&E-stained lung tissue slide showing anthracotic pigment deposits"
  />
  <div class="container-page py-12">
    <PubList pubs={pubs} />
  </div>
</BaseLayout>
