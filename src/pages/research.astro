---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ResearchAreaIcon from "../components/ResearchAreaIcon.astro";
import { RESEARCH_GROUPS, AREA_LABELS, type AreaSlug } from "../lib/content";
import xeniumExplorer from "../assets/photos/xenium-explorer.jpg";

// Maps each research-topic area to its animated icon on the homepage
// (src/components/ResearchAreaIcon.astro) — keep these in sync.
const ICON_BY_AREA: Partial<Record<AreaSlug, 1 | 2 | 3>> = {
  "cancer-origins": 1,
  "cancer-prevention": 2,
  "aging-cancer-risk": 3,
};
---

<BaseLayout
  title="Research"
  description="An overview of the lab's research topics and methods."
>
  <PageHeader
    eyebrow="What we do"
    title="Research"
    lead="A short overview of what the lab studies and how. Explore our work by topic or by approach."
    image={xeniumExplorer}
    imageAlt="Xenium spatial transcriptomics image of tissue showing multiplexed cellular markers"
  />
  <div class="container-page space-y-16 py-12">
    {
      RESEARCH_GROUPS.map((group) => (
        <section>
          <div class="mb-3 h-1 w-12 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{group.title}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.areas.map((area) => (
              <div id={area.slug} class="scroll-mt-24 flex flex-col items-center rounded-xl border border-slate-200 p-6 text-center">
                {ICON_BY_AREA[area.slug] && <ResearchAreaIcon n={ICON_BY_AREA[area.slug]!} />}
                <h3 class="mt-3 font-serif text-2xl font-semibold text-slate-900">{AREA_LABELS[area.slug]}</h3>
                <p class="mt-2 max-w-3xl text-slate-600">{area.blurb}</p>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
